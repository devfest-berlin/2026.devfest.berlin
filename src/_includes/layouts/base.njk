<!DOCTYPE html>
<html lang="en" class="auto-color">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or site.title }}</title>
    <meta name="description" content="{{ description or site.description }}">
    {% if noindex %}
    <meta name="robots" content="noindex">
    {% else %}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    {% endif %}
    <meta name="theme-color" content="{{ site.accentColor or '#1a73e8' }}">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="stylesheet" href="/assets/css/screen.css">

    <style>
        :root {
            --ghost-accent-color: {{ site.accentColor or '#1a73e8' }};
        }
    </style>

    <!-- Open Graph / Social Cards -->
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ description or site.description }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    {% if site.ogImage or site.coverImage %}
    <meta property="og:image" content="{{ site.url }}{{ site.ogImage or site.coverImage }}">
    {% endif %}
    {% if site.ogImage and site.ogImageWidth and site.ogImageHeight %}
    <meta property="og:image:width" content="{{ site.ogImageWidth }}">
    <meta property="og:image:height" content="{{ site.ogImageHeight }}">
    {% endif %}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or site.title }}">
    <meta name="twitter:description" content="{{ description or site.description }}">
    {% if site.ogImage or site.coverImage %}
    <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage or site.coverImage }}">
    {% endif %}
    {% if page.url == "/" %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Event",
        "name": {{ site.title | dump | safe }},
        "description": {{ site.description | dump | safe }},
        "startDate": {{ site.eventDate | dump | safe }},
        "endDate": {{ site.eventDate | dump | safe }},
        "eventStatus": "https://schema.org/EventScheduled",
        "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
        "url": {{ site.url | dump | safe }},
        "image": {{ (site.url + (site.ogImage or site.coverImage)) | dump | safe }},
        "location": {
            "@type": "Place",
            "name": {{ site.venue.name | dump | safe }},
            "address": { "@type": "PostalAddress", "addressLocality": "Berlin", "addressCountry": "DE" }
        },
        "organizer": { "@type": "Organization", "name": {{ site.organizerName | dump | safe }}, "url": {{ site.url | dump | safe }} }
    }
    </script>
    {% endif %}
</head>
<body class="{% if bodyClass %}{{ bodyClass }}{% else %}home-template is-head-left-logo has-cover{% endif %}">
<div class="viewport">

    <header id="gh-head" class="gh-head outer">
        <div class="gh-head-inner inner">
            <div class="gh-head-brand">
                <a class="gh-head-logo no-image" href="/">
                    {{ site.title }}
                </a>
                <button class="gh-burger" aria-label="Main Menu" aria-expanded="false" aria-controls="gh-head-menu"></button>
            </div>

            <nav class="gh-head-menu" id="gh-head-menu" aria-label="Main navigation">
                <ul class="nav">
                    {% for item in site.navigation %}
                    <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                    {% endfor %}
                    {% if site.cfp.status == "open" and site.cfp.url %}
                    <li><a href="{{ site.cfp.url }}" target="_blank" rel="noopener">{{ site.cfp.label }}</a></li>
                    {% endif %}
                </ul>
            </nav>

            <div class="gh-head-actions">
                {% if site.tickets.status == "open" and site.tickets.url %}
                <a class="gh-head-button" href="{{ site.tickets.url }}" target="_blank" rel="noopener">{{ site.tickets.buttonText }}</a>
                {% elif site.cfp.status == "open" and site.cfp.url %}
                <a class="gh-head-button" href="{{ site.cfp.url }}" target="_blank" rel="noopener">{{ site.cfp.buttonText }}</a>
                {% else %}
                <a class="gh-head-button" href="/#subscribe">Stay Tuned</a>
                {% endif %}
            </div>
        </div>
    </header>

    <div class="site-content">
        {{ content | safe }}
    </div>

    <footer class="site-footer outer">
        <div class="inner">
            <section class="copyright">
                <a href="/">{{ site.title }}</a> &copy; {% year %}
            </section>

            <div class="site-footer-center">
                <nav class="site-footer-nav" aria-label="Footer">
                    <ul class="nav">
                        {% for item in site.legalNavigation %}
                        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
                        {% endfor %}
                        {% for item in site.footerNavigation %}
                        <li><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.label }}</a></li>
                        {% endfor %}
                        {% for item in site.socialLinks %}
                        <li><a href="{{ item.url }}" target="_blank" rel="noopener">{{ item.name }}</a></li>
                        {% endfor %}
                        <li><a href="https://github.com/TryGhost/Casper" target="_blank" rel="noopener">Design adopted from Casper by Ghost</a></li>
                    </ul>
                </nav>
            </div>

            <div class="gh-powered-by">
                <span>Organized by BDG e. V.</span>
            </div>
        </div>
    </footer>

</div>

<script src="/assets/js/main.js" defer></script>
</body>
</html>
