                            <span>Android &amp; Kotlin</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="#00ADD8"><path d="M1.811 10.231c-.047-.308-.035-.615.034-.908.153-.65 1.002-1.078 1.895-.956.892.122 1.488.75 1.334 1.4-.047.202-.158.384-.316.524a2.915 2.915 0 0 0 .584.092c.621.045 1.157-.156 1.46-.576.26-.358.307-.84.14-1.393-.243-.808-.946-1.503-1.893-1.892a4.996 4.996 0 0 0-2.02-.387c-1.314.032-2.45.69-2.923 1.696-.34.723-.312 1.54.077 2.302.327.64.912 1.18 1.637 1.533zm16.59-1.306c-.846-.358-1.921-.384-2.998-.073-1.228.354-2.202 1.127-2.673 2.12-.423.89-.356 1.884.185 2.723.513.795 1.378 1.353 2.373 1.528 1.144.202 2.345-.078 3.298-.769a4.847 4.847 0 0 0 1.657-2.31c.328-.997.172-1.942-.422-2.585-.386-.418-.887-.584-1.42-.634zm-1.884 4.316c-.636.184-1.294.043-1.637-.367-.323-.385-.297-.978.072-1.565.342-.544.896-.925 1.532-1.05.635-.125 1.22.12 1.472.613.238.463.13 1.096-.285 1.625-.262.333-.67.618-1.154.744z"/><path d="M12.012 15.545c-2.457 0-4.456-1.99-4.456-4.437s1.999-4.437 4.456-4.437c1.376 0 2.61.624 3.425 1.613l-1.42 1.184a2.593 2.593 0 0 0-2.005-.956c-1.439 0-2.613 1.168-2.613 2.596 0 1.428 1.174 2.596 2.613 2.596.953 0 1.776-.514 2.213-1.282h-2.213v-1.745h4.116c.054.298.082.607.082.924 0 2.227-1.775 3.944-4.198 3.944z"/></svg>
                            <span>Go</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="#F05138"><path d="M21.91 16.89C21.6 17.5 19.33 21 15.65 21c-2.3 0-3.32-1.41-5.75-1.41-2.46 0-3.79 1.46-5.78 1.46-3.8 0-6.12-3.84-6.12-7.55 0-4.76 3.19-7.23 6.1-7.23 2.43 0 3.75 1.34 5.3 1.34 1.5 0 2.46-1.34 5.25-1.34 2.22 0 4.19 1.07 5.16 2.55-4.14 2.05-3.47 7.4 1.1 9.07zM15.42 4.41c1.07-1.33 1.83-3.18 1.62-5.06-1.57.08-3.48 1.07-4.57 2.37-1 .17-1.85 3.03-1.61 4.88 1.77.14 3.49-.86 4.56-2.19z"/></svg>
                            <span>iOS &amp; Swift</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-career">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    </div>
                    <h3 class="track-title">Career &amp; Practices</h3>
                    <p class="track-description">
                        Engineering leadership, Management vs. IC tracks, technical interviewing, UX design, and project rituals.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#EA8600" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Team Culture</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#E91E63" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            <span>UX &amp; Product</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="#1a73e8"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                            <span>Tech Leadership</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#5F6368" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            <span>Career Pathways</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-hardware">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                    </div>
                    <h3 class="track-title">Robotics &amp; Hardware</h3>
                    <p class="track-description">
                        IoT ecosystems, edge computing, hardware integration, and physical computing with connected devices.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#9C27B0" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><circle cx="12" cy="20" r="1" fill="#9C27B0"/></svg>
                            <span>IoT Systems</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#673AB7" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3" fill="#673AB7"/><path d="M12 1v3M12 20v3M20 12h3M1 12h3"/></svg>
                            <span>Edge AI</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#E65100" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            <span>Hardware &amp; Sensors</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#00897B" stroke-width="2"><rect x="5" y="5" width="14" height="14" rx="1"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/></svg>
                            <span>Embedded Tech</span>
                        </li>
                    </ul>
                </div>
            </div>

            {% if site.cfp.status == "open" and site.cfp.url %}
            <div class="speaker-perks-section">
                <h3 class="perks-heading">Why Speak at DevFest Berlin?</h3>
                <div class="perks-grid">
                    {% for perk in site.speakerPerks %}
                    <div class="perk-card">
                        <div class="perk-icon-wrap">
                            {% if perk.icon == "pass" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2"/></svg>
                            {% elif perk.icon == "mixer" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            {% elif perk.icon == "video" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                            {% elif perk.icon == "mentor" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                            {% endif %}
                        </div>
                        <h4 class="perk-title">{{ perk.title }}</h4>
                        <p class="perk-text">{{ perk.description }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="tracks-cta">
                <p>Have an insight, case study, or deep dive to share with Berlin's tech community?</p>
                <a class="track-cta-button" href="{{ site.cfp.url }}" target="_blank" rel="noopener">
                    <span>Submit Your Talk on Sessionize</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <span class="track-cta-deadline">CFP closes November 1, 2026 at 23:59 CET</span>
            </div>
            {% endif %}
        </div>
    </section>

    <!-- Date & Venue Section -->
    <section id="venue" class="outer venue-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Date & Location</h2>
                <p class="section-subtitle">Join us in Neukölln for Berlin's flagship community developer festival.</p>
            </div>

            <div class="venue-card-interactive">
                <div class="venue-interactive-main">
                    <div class="venue-header-row">
                        <div class="venue-icon-badge">
                            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div>
                            <span class="venue-badge">Host Campus</span>
                            <h3 class="venue-title">{{ site.venue.name }}</h3>
                            <p class="venue-address">{{ site.venue.streetAddress }}, {{ site.venue.postalCode }} Berlin ({{ site.venue.neighborhood }})</p>
                        </div>
                    </div>

                    <div class="venue-transit-info">
                        <div class="transit-item">
                            <span class="transit-badge s-bahn">S-Bahn</span>
                            <span><strong>S41, S42 (Ringbahn), S45, S46, S47</strong> &mdash; S Sonnenallee or S Köllnische Heide (5&ndash;8 min walk)</span>
                        </div>
                        <div class="transit-item">
                            <span class="transit-badge bus">Bus M41</span>
                            <span>Direct connection from <strong>Berlin Hbf, Potsdamer Platz &amp; Hermannplatz</strong> to Sonnenallee</span>
                        </div>
                    </div>

                    <div class="venue-action-buttons">
                        <a class="venue-action-btn primary" href="{{ site.venue.mapsUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                            <span>Open in Google Maps</span>
                        </a>
                        <a class="venue-action-btn secondary" href="{{ site.venue.transitUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="16" rx="2"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/><line x1="4" y1="11" x2="20" y2="11"/></svg>
                            <span>BVG Transit Route</span>
                        </a>
                        {% if site.calendarUrl %}
                        <a class="venue-action-btn outline" href="{{ site.calendarUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            <span>Add to Calendar</span>
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="outer faq-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Frequently Asked Questions</h2>
                <p class="section-subtitle">
                    Everything you need to know about DevFest Berlin 2026.
                </p>
            </div>

            <div class="faq-accordion">
                <details class="faq-item">
                    <summary>Where is the venue and how do I get there?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin 2026 takes place at <strong>SRH Berlin University of Applied Sciences</strong>,
                            located at <strong>Sonnenallee 221, 12059 Berlin</strong> (Neukölln).
                        </p>
                        <p>
                            <strong>Public Transit:</strong><br>
                            &bull; <strong>S-Bahn:</strong> S41, S42 (Ringbahn), S45, S46, S47 (Station <em>S Sonnenallee</em> or <em>S Köllnische Heide</em>, ~5–8 min walk).<br>
                            &bull; <strong>Bus:</strong> M41 (direct connection from Berlin Hauptbahnhof, Potsdamer Platz, and Hermannplatz).
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When does the Call for Speakers (CFP) close?</summary>
                    <div class="faq-answer">
                        <p>
                            The Call for Speakers is open through <strong>November 1, 2026 at 11:59 PM CET</strong>.
                            You can submit talk proposals directly on <a href="{{ site.cfp.url }}" target="_blank" rel="noopener">Sessionize</a>.
                            Speaker selections and schedule announcements will follow in early November.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>Who can submit a talk proposal?</summary>
                    <div class="faq-answer">
                        <p>
                            We warmly encourage speakers of all backgrounds, genders, and experience levels—including first-time speakers.
                            Whether you are presenting a beginner-friendly introduction or a deep technical dive, our community welcomes your perspective.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When will ticket sales go live?</summary>
                    <div class="faq-answer">
                        <p>
                            Ticket registration will open soon. Sign up via the <a href="/#subscribe">newsletter above</a> to be notified the moment Early Bird tickets go on sale.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>What is the Code of Conduct?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin is dedicated to providing a harassment-free and inclusive conference experience for everyone.
                            All attendees, speakers, sponsors, and organizers are required to adhere to the
                            <a href="https://berlincodeofconduct.org/en" target="_blank" rel="noopener">Berlin Code of Conduct</a>
                            and Google Event Community Guidelines throughout the event.
                        </p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Organizers Section -->
    <section id="organizers" class="outer organizers-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Community Organizers</h2>
                <p class="section-subtitle">
                    DevFest Berlin is collaboratively organized by local tech communities.
                </p>
            </div>

            <div class="organizers-grid">
                {% for org in site.organizers %}
                <div class="organizer-card">
                    <div>
                        <div class="organizer-card-header">
                            {% if org.logo %}
                            <div class="organizer-logo-wrap">
                                <img src="{{ org.logo }}" alt="{{ org.name }} logo" class="organizer-logo" loading="lazy" />
                            </div>
                            {% endif %}
                            <h3 class="organizer-name">{{ org.name }}</h3>
                        </div>
                        <p class="organizer-description">{{ org.description }}</p>
                    </div>
                    <div class="organizer-card-action">
                        <a class="card-link" href="{{ org.url }}" target="_blank" rel="noopener">
                            Join Community &rarr;
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Sponsors Section -->
    <section id="sponsors" class="outer sponsors-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">{{ site.sponsorship.title }}</h2>
                <p class="section-subtitle">{{ site.sponsorship.pitch }}</p>
            </div>
            {% if site.sponsors.length %}
            {% include "partials/sponsor-wall.njk" %}
            {% endif %}
            <p class="sponsors-action">
                <a class="sponsor-button" href="/sponsors/">Become a sponsor</a>
            </p>
        </div>
    </section>

