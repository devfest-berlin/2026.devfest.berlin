                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="#326CE5"><path d="M11.998.11a1.14 1.14 0 0 0-.573.155L2.35 5.518a1.14 1.14 0 0 0-.57.989v10.986c0 .41.22.787.57.989l9.075 5.253a1.14 1.14 0 0 0 1.146 0l9.075-5.253a1.14 1.14 0 0 0 .57-.989V6.507a1.14 1.14 0 0 0-.57-.989L12.571.265a1.14 1.14 0 0 0-.573-.155zm-.016 2.455l6.98 4.041-2.43 1.408-4.55-2.637v-2.812zm-1.042.006v2.806L6.39 8.014 3.96 6.606l6.98-4.035zM2.85 7.97l2.43 1.408v5.275L2.85 16.06V7.97zm18.3 0v8.09l-2.43-1.407V9.378l2.43-1.408zm-8.652 1.488a2.54 2.54 0 1 1 0 5.08 2.54 2.54 0 0 1 0-5.08zm-4.707 5.766l4.185 2.424v4.832l-6.615-3.83 2.43-3.426zm10.456 0l2.43 3.426-6.615 3.83v-4.832l4.185-2.424z"/></svg>
                            <span>Kubernetes</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#EA4335" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                            <span>Cybersecurity</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#4285F4" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
                            <span>DevOps &amp; Infra</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-mobile">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    </div>
                    <h3 class="track-title">Languages &amp; Mobile</h3>
                    <p class="track-description">
                        Building performant applications with Go, Kotlin, Dart, Flutter, React Native, Android, and iOS.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="18" height="18"><path fill="#42A5F5" d="M14.314 0L2.3 12l3.694 3.694L21.703 0h-7.389z"/><path fill="#02569B" d="M14.314 11.077L7.842 17.55l3.694 3.694 2.778-2.778 7.389-7.389h-7.389z"/><path fill="#0175C2" d="M11.536 21.244l2.778 2.756h7.389l-5.545-5.534-4.622 2.778z"/><path fill="#29B6F6" d="M14.314 11.077l4.622 4.622-4.622 4.622-2.778-2.778 2.778-6.466z"/></svg>
                            <span>Flutter &amp; Dart</span>
                        </li>
                        <li>
