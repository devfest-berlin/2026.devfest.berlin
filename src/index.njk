---
layout: base.njk
bodyClass: "home-template is-head-left-logo has-cover"
---


<!-- Casper Hero Header -->
<div class="site-header-content outer">
    {% if site.coverImage %}
    <img class="site-header-cover"
        src="{{ site.coverImage }}"
        alt="{{ site.title }}"
        fetchpriority="high"
        loading="eager"
    />
    {% endif %}

    <div class="site-header-inner inner">
        {% if site.status %}
        <div class="status-pill">{{ site.status }}</div>
        {% endif %}
        <h1 class="site-title">{{ site.title }}</h1>
        {% if site.description %}
        <p class="site-description">{{ site.description }}</p>
        {% endif %}
        {% set cfpOpen = site.cfp.status == "open" and site.cfp.url %}
        {% set ticketsOpen = site.tickets.status == "open" and site.tickets.url %}
        {% if cfpOpen or ticketsOpen %}
        <div class="hero-actions">
            {% if ticketsOpen %}
            <a class="hero-button" href="{{ site.tickets.url }}" target="_blank" rel="noopener">{{ site.tickets.buttonText }}</a>
            {% endif %}
            {% if cfpOpen %}
            <a class="hero-button{% if ticketsOpen %} is-secondary{% endif %}" href="{{ site.cfp.url }}" target="_blank" rel="noopener">{{ site.cfp.buttonText }}</a>
            {% endif %}
            {% if site.calendarUrl %}
            <a class="hero-button is-calendar" href="{{ site.calendarUrl }}" target="_blank" rel="noopener" title="Add to Calendar">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Add to Calendar</span>
            </a>
            {% endif %}
        </div>
        {% if cfpOpen and site.cfp.deadline %}
        <p class="hero-note">{{ site.cfp.label }} open until {{ site.cfp.deadline }}</p>
        {% endif %}
        {% elif site.cfp.status == "closed" %}
        <p class="hero-note">{{ site.cfp.label }} is closed. Thank you to everyone who submitted.</p>
        {% endif %}
    </div>
</div>

<!-- Conference Impact Statistics (Inspired by DevFest Istanbul) -->
{% if site.stats.length %}
<section class="outer stats-section" aria-label="DevFest Berlin by the numbers">
    <div class="inner">
        <div class="stats-grid">
            {% for item in site.stats %}
            <div class="stat-card">
                <div class="stat-value">{{ item.value }}</div>
                <div class="stat-label">{{ item.label }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<main id="site-main" class="site-main">

    <!-- Newsletter / Subscribe Call to Action -->
    <section id="subscribe" class="footer-cta outer subscribe-section">
        <div class="inner">
            <h2 class="footer-cta-title">{{ site.newsletter.title }}</h2>
            <p style="max-width: 600px; margin: 0 auto 28px; font-size: 1.7rem; color: var(--color-secondary-text);">
                {{ site.newsletter.description }}
            </p>

            <form id="subscribe-form" class="footer-cta-form" action="{{ site.newsletter.action }}" method="POST">
                <input
                    type="email"
                    name="{{ site.newsletter.emailFieldName }}"
                    placeholder="Enter your email address"
                    aria-label="Email address"
                    required
                />
                <button type="submit">{{ site.newsletter.buttonText }}</button>
            </form>
            <div id="subscribe-feedback" class="subscribe-feedback" role="status" aria-live="polite"></div>
            {% if site.newsletter.privacyNote %}
            <p class="subscribe-privacy">
                {{ site.newsletter.privacyNote }} <a href="/datenschutz/#newsletter">Privacy details</a>
            </p>
            {% endif %}
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="outer about-section">
        <div class="inner about-content">
            <h2 class="section-title">What is DevFest?</h2>
            <p class="about-text">
                DevFests are community-led developer events hosted by Google Developer Groups worldwide.
                DevFest Berlin brings together engineers, designers, and tech leaders for talks, workshops,
                and networking across Android, Web, Cloud, AI, and more.
            </p>
        </div>
    </section>

    <!-- Tracks & Topics Section -->
    <section id="tracks" class="outer tracks-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Tracks & Topics</h2>
                <p class="section-subtitle">
                    Explore talks, panels, and deep technical dives across five curated themes for DevFest Berlin 2026.
                </p>
            </div>

            <div class="tracks-grid">
                <div class="track-card">
                    <div class="track-icon-badge is-ai">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2Z"/><circle cx="12" cy="12" r="3"/><path d="M12 2v10l8.5 4.5"/></svg>
                    </div>
                    <h3 class="track-title">AI & Machine Learning</h3>
                    <p class="track-description">
                        Applications, ethics, dev tools, model management, and practical agentic workflows with modern AI.
                    </p>
                    <ul class="track-tags">
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/></svg><span>LLMs & Gemini</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><circle cx="6" cy="18" r="3"/><circle cx="18" cy="18" r="3"/><circle cx="12" cy="6" r="3"/><line x1="8.5" y1="16" x2="15.5" y2="16" stroke="currentColor" stroke-width="1.5"/><line x1="7.5" y1="15.5" x2="10.5" y2="8.5" stroke="currentColor" stroke-width="1.5"/><line x1="16.5" y1="15.5" x2="13.5" y2="8.5" stroke="currentColor" stroke-width="1.5"/></svg><span>Agents & RAG</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg><span>MLOps</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg><span>AI Ethics</span></li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-cloud">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/><path d="M12 12v4M10 14h4"/></svg>
                    </div>
                    <h3 class="track-title">Cloud & Security</h3>
                    <p class="track-description">
                        GCP, multi-cloud architectures, cybersecurity, DevSecOps, and robust infrastructure threat defense.
                    </p>
                    <ul class="track-tags">
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/></svg><span>Google Cloud</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><line x1="12" y1="3" x2="12" y2="9"/><line x1="12" y1="15" x2="12" y2="21"/><line x1="4.2" y1="7.5" x2="9.4" y2="10.5"/><line x1="14.6" y1="13.5" x2="19.8" y2="16.5"/></svg><span>Kubernetes</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Cybersecurity</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg><span>Infrastructure</span></li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-mobile">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    </div>
                    <h3 class="track-title">Languages & Mobile</h3>
                    <p class="track-description">
                        Building performant applications with Go, Kotlin, Dart, Flutter, React Native, Android, and iOS.
                    </p>
                    <ul class="track-tags">
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M14.3 2L5 11.3l2.8 2.8L17.1 4.8h-2.8zm0 8.8L9.1 16l2.8 2.8 5.2-5.2h-2.8zm2.8 8L14.3 16l-2.4 2.4L14.3 22h2.8z"/></svg><span>Flutter & Dart</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zM3.5 8C2.67 8 2 8.67 2 9.5v6c0 .83.67 1.5 1.5 1.5S5 16.33 5 15.5v-6C5 8.67 4.33 8 3.5 8zm17 0c-.83 0-1.5.67-1.5 1.5v6c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-6c0-.83-.67-1.5-1.5-1.5zm-4.97-4.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 2.23 12.95 2 12 2c-.96 0-1.86.23-2.66.63L7.85 1.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 4.26 6 5.76 6 7.5h12c0-1.74-.97-3.24-2.47-4.34z"/></svg><span>Android & Kotlin</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M4 10c0-3.3 2.7-6 6-6 2.4 0 4.4 1.4 5.4 3.4h-2.9C11.8 6.5 10.7 6 9.5 6 7.6 6 6 7.6 6 9.5S7.6 13 9.5 13c1.3 0 2.5-.7 3.2-1.7H10V9h7.5v5.5c-1.7 2.3-4.4 3.7-7.5 3.7C5.1 18.2 2 15.1 2 11.2V10z"/></svg><span>Go</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.85c.67-.82 1.13-1.96.99-3.1-.98.04-2.15.66-2.83 1.47-.6.7-.1.14-1.85.99 3.01 1.09-.03 2.18-.62 2.85-1.38z"/></svg><span>iOS & Swift</span></li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-career">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    </div>
                    <h3 class="track-title">Career & Practices</h3>
                    <p class="track-description">
                        Engineering leadership, Management vs. IC tracks, technical interviewing, UX design, and project rituals.
                    </p>
                    <ul class="track-tags">
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg><span>Team Culture</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.7-.8 1.7-1.7 0-.4-.2-.8-.5-1.1-.3-.3-.4-.7-.4-1.2 0-.9.8-1.7 1.7-1.7H16c3.3 0 6-2.7 6-6 0-5.5-4.5-9.3-10-9.3z"/></svg><span>UX & Product</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg><span>Leadership</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg><span>Tech Career</span></li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-hardware">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                    </div>
                    <h3 class="track-title">Robotics & Hardware</h3>
                    <p class="track-description">
                        IoT ecosystems, edge computing, hardware integration, and physical computing with connected devices.
                    </p>
                    <ul class="track-tags">
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><circle cx="12" cy="20" r="1"/></svg><span>IoT</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/><path d="M12 1v3M12 20v3M20 12h3M1 12h3"/></svg><span>Edge AI</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg><span>Hardware</span></li>
                        <li><svg class="tag-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg><span>Embedded</span></li>
                    </ul>
                </div>
            </div>

            {% if site.cfp.status == "open" and site.cfp.url %}
            <div class="speaker-perks-section">
                <h3 class="perks-heading">Why Speak at DevFest Berlin?</h3>
                <div class="perks-grid">
                    {% for perk in site.speakerPerks %}
                    <div class="perk-card">
                        <div class="perk-icon-wrap">
                            {% if perk.icon == "pass" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2"/></svg>
                            {% elif perk.icon == "mixer" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            {% elif perk.icon == "video" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                            {% elif perk.icon == "mentor" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                            {% endif %}
                        </div>
                        <h4 class="perk-title">{{ perk.title }}</h4>
                        <p class="perk-text">{{ perk.description }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="tracks-cta">
                <p>Have an insight, case study, or deep dive to share with Berlin's tech community?</p>
                <a class="track-cta-button" href="{{ site.cfp.url }}" target="_blank" rel="noopener">
                    <span>Submit Your Talk on Sessionize</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <span class="track-cta-deadline">CFP closes November 1, 2026 at 23:59 CET</span>
            </div>
            {% endif %}
        </div>
    </section>

    <!-- Date & Venue Section -->
    <section id="venue" class="outer venue-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Date & Location</h2>
                <p class="section-subtitle">Join us in Neukölln for Berlin's flagship community developer festival.</p>
            </div>

            <div class="venue-card-interactive">
                <div class="venue-interactive-main">
                    <div class="venue-header-row">
                        <div class="venue-icon-badge">
                            <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                        </div>
                        <div>
                            <span class="venue-badge">Host Campus</span>
                            <h3 class="venue-title">{{ site.venue.name }}</h3>
                            <p class="venue-address">{{ site.venue.streetAddress }}, {{ site.venue.postalCode }} Berlin ({{ site.venue.neighborhood }})</p>
                        </div>
                    </div>

                    <div class="venue-transit-info">
                        <div class="transit-item">
                            <span class="transit-badge s-bahn">S-Bahn</span>
                            <span><strong>S41, S42 (Ringbahn), S45, S46, S47</strong> &mdash; S Sonnenallee or S Köllnische Heide (5&ndash;8 min walk)</span>
                        </div>
                        <div class="transit-item">
                            <span class="transit-badge bus">Bus M41</span>
                            <span>Direct connection from <strong>Berlin Hbf, Potsdamer Platz &amp; Hermannplatz</strong> to Sonnenallee</span>
                        </div>
                    </div>

                    <div class="venue-action-buttons">
                        <a class="venue-action-btn primary" href="{{ site.venue.mapsUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                            <span>Open in Google Maps</span>
                        </a>
                        <a class="venue-action-btn secondary" href="{{ site.venue.transitUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="16" rx="2"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/><line x1="4" y1="11" x2="20" y2="11"/></svg>
                            <span>BVG Transit Route</span>
                        </a>
                        {% if site.calendarUrl %}
                        <a class="venue-action-btn outline" href="{{ site.calendarUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            <span>Add to Calendar</span>
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="outer faq-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Frequently Asked Questions</h2>
                <p class="section-subtitle">
                    Everything you need to know about DevFest Berlin 2026.
                </p>
            </div>

            <div class="faq-accordion">
                <details class="faq-item">
                    <summary>Where is the venue and how do I get there?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin 2026 takes place at <strong>SRH Berlin University of Applied Sciences</strong>,
                            located at <strong>Sonnenallee 221, 12059 Berlin</strong> (Neukölln).
                        </p>
                        <p>
                            <strong>Public Transit:</strong><br>
                            &bull; <strong>S-Bahn:</strong> S41, S42 (Ringbahn), S45, S46, S47 (Station <em>S Sonnenallee</em> or <em>S Köllnische Heide</em>, ~5–8 min walk).<br>
                            &bull; <strong>Bus:</strong> M41 (direct connection from Berlin Hauptbahnhof, Potsdamer Platz, and Hermannplatz).
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When does the Call for Speakers (CFP) close?</summary>
                    <div class="faq-answer">
                        <p>
                            The Call for Speakers is open through <strong>November 1, 2026 at 11:59 PM CET</strong>.
                            You can submit talk proposals directly on <a href="{{ site.cfp.url }}" target="_blank" rel="noopener">Sessionize</a>.
                            Speaker selections and schedule announcements will follow in early November.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>Who can submit a talk proposal?</summary>
                    <div class="faq-answer">
                        <p>
                            We warmly encourage speakers of all backgrounds, genders, and experience levels—including first-time speakers.
                            Whether you are presenting a beginner-friendly introduction or a deep technical dive, our community welcomes your perspective.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When will ticket sales go live?</summary>
                    <div class="faq-answer">
                        <p>
                            Ticket registration will open soon. Sign up via the <a href="/#subscribe">newsletter above</a> to be notified the moment Early Bird tickets go on sale.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>What is the Code of Conduct?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin is dedicated to providing a harassment-free and inclusive conference experience for everyone.
                            All attendees, speakers, sponsors, and organizers are required to adhere to the
                            <a href="https://berlincodeofconduct.org/en" target="_blank" rel="noopener">Berlin Code of Conduct</a>
                            and Google Event Community Guidelines throughout the event.
                        </p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Organizers Section -->
    <section id="organizers" class="outer organizers-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Community Organizers</h2>
                <p class="section-subtitle">
                    DevFest Berlin is collaboratively organized by local tech communities.
                </p>
            </div>

            <div class="organizers-grid">
                {% for org in site.organizers %}
                <div class="organizer-card">
                    <div>
                        <div class="organizer-card-header">
                            {% if org.logo %}
                            <div class="organizer-logo-wrap">
                                <img src="{{ org.logo }}" alt="{{ org.name }} logo" class="organizer-logo" loading="lazy" />
                            </div>
                            {% endif %}
                            <h3 class="organizer-name">{{ org.name }}</h3>
                        </div>
                        <p class="organizer-description">{{ org.description }}</p>
                    </div>
                    <div class="organizer-card-action">
                        <a class="card-link" href="{{ org.url }}" target="_blank" rel="noopener">
                            Join Community &rarr;
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Sponsors Section -->
    <section id="sponsors" class="outer sponsors-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">{{ site.sponsorship.title }}</h2>
                <p class="section-subtitle">{{ site.sponsorship.pitch }}</p>
            </div>
            {% if site.sponsors.length %}
            {% include "partials/sponsor-wall.njk" %}
            {% endif %}
            <p class="sponsors-action">
                <a class="sponsor-button" href="/sponsors/">Become a sponsor</a>
            </p>
        </div>
    </section>

