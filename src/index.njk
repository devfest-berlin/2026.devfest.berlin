</main>

<!-- Early Bird Notification Modal Dialog -->
<dialog id="earlybird-modal" class="earlybird-dialog" aria-labelledby="earlybird-modal-title">
    <div class="earlybird-dialog-card">
        <button type="button" class="earlybird-dialog-close" id="close-earlybird-modal" aria-label="Close dialog">&times;</button>
        <div class="earlybird-badge">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            <span>Priority Access</span>
        </div>
        <h2 id="earlybird-modal-title" class="earlybird-dialog-title">Get Early Bird Ticket Alerts</h2>
        <p class="earlybird-dialog-text">
            Ticket sales will open soon with limited heavily-discounted Early Bird passes. Leave your email to receive private priority booking before public release.
        </p>
        <form id="earlybird-form" class="earlybird-dialog-form" action="{{ site.newsletter.action }}" method="POST">
            <div class="earlybird-input-group">
                <input
                    type="email"
                    name="{{ site.newsletter.emailFieldName }}"
                    id="earlybird-email-input"
                    placeholder="developer@example.com"
                    aria-label="Email address for ticket alert"
                    required
                />
                <button type="submit" class="earlybird-submit-btn">Notify Me</button>
            </div>
            <div id="earlybird-feedback" class="subscribe-feedback" role="status" aria-live="polite"></div>
            <p class="earlybird-note">
                Zero spam. You will only receive official DevFest Berlin announcements. <a href="/datenschutz/#newsletter" target="_blank" rel="noopener">Privacy Policy</a>
            </p>
        </form>
    </div>
</dialog>
