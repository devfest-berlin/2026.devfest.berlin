---
layout: base.njk
bodyClass: "home-template is-head-left-logo has-cover"
---


<!-- Casper Hero Header -->
<div class="site-header-content outer">
    {% if site.coverImage %}
    <img class="site-header-cover"
        src="{{ site.coverImage }}"
        alt="{{ site.title }}"
        fetchpriority="high"
        loading="eager"
    />
    {% endif %}

    <div class="site-header-inner inner">
        {% if site.status %}
        <div class="status-pill">{{ site.status }}</div>
        {% endif %}
        <h1 class="site-title">{{ site.title }}</h1>
        {% if site.description %}
        <p class="site-description">{{ site.description }}</p>
        {% endif %}
        {% set cfpOpen = site.cfp.status == "open" and site.cfp.url %}
        {% set ticketsOpen = site.tickets.status == "open" and site.tickets.url %}
        {% if cfpOpen or ticketsOpen %}
        <div class="hero-actions">
            {% if ticketsOpen %}
            <a class="hero-button" href="{{ site.tickets.url }}" target="_blank" rel="noopener">{{ site.tickets.buttonText }}</a>
            {% endif %}
            {% if cfpOpen %}
            <a class="hero-button{% if ticketsOpen %} is-secondary{% endif %}" href="{{ site.cfp.url }}" target="_blank" rel="noopener">{{ site.cfp.buttonText }}</a>
            {% endif %}
        </div>
        {% if cfpOpen and site.cfp.deadline %}
        <p class="hero-note">{{ site.cfp.label }} open until {{ site.cfp.deadline }}</p>
        {% endif %}
        {% elif site.cfp.status == "closed" %}
        <p class="hero-note">{{ site.cfp.label }} is closed. Thank you to everyone who submitted.</p>
        {% endif %}
    </div>
</div>

<main id="site-main" class="site-main">

    <!-- Newsletter / Subscribe Call to Action -->
    <section id="subscribe" class="footer-cta outer subscribe-section">
        <div class="inner">
            <h2 class="footer-cta-title">{{ site.newsletter.title }}</h2>
            <p style="max-width: 600px; margin: 0 auto 28px; font-size: 1.7rem; color: var(--color-secondary-text);">
                {{ site.newsletter.description }}
            </p>

            <form id="subscribe-form" class="footer-cta-form" action="{{ site.newsletter.action }}" method="POST">
                <input
                    type="email"
                    name="{{ site.newsletter.emailFieldName }}"
                    placeholder="Enter your email address"
                    aria-label="Email address"
                    required
                />
                <button type="submit">{{ site.newsletter.buttonText }}</button>
            </form>
            <div id="subscribe-feedback" class="subscribe-feedback" role="status" aria-live="polite"></div>
            {% if site.newsletter.privacyNote %}
            <p class="subscribe-privacy">
                {{ site.newsletter.privacyNote }} <a href="/datenschutz/#newsletter">Privacy details</a>
            </p>
            {% endif %}
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="outer about-section">
        <div class="inner about-content">
            <h2 class="section-title">What is DevFest?</h2>
            <p class="about-text">
                DevFests are community-led developer events hosted by Google Developer Groups worldwide.
                DevFest Berlin brings together engineers, designers, and tech leaders for talks, workshops,
                and networking across Android, Web, Cloud, AI, and more.
            </p>
        </div>
    </section>

    <!-- Tracks & Topics Section -->
    <section id="tracks" class="outer tracks-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Tracks & Topics</h2>
                <p class="section-subtitle">
                    Explore talks, panels, and deep technical dives across five curated themes for DevFest Berlin 2026.
                </p>
            </div>

            <div class="tracks-grid">
                <div class="track-card">
                    <div class="track-icon">🤖</div>
                    <h3 class="track-title">AI & Machine Learning</h3>
                    <p class="track-description">
                        Applications, ethics, dev tools, model management, and practical agentic workflows with modern AI.
                    </p>
                    <ul class="track-tags">
                        <li>LLMs & Gemini</li>
                        <li>Agents & RAG</li>
                        <li>MLOps</li>
                        <li>AI Ethics</li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon">☁️</div>
                    <h3 class="track-title">Cloud & Security</h3>
                    <p class="track-description">
                        GCP, multi-cloud architectures, cybersecurity, DevSecOps, and robust infrastructure threat defense.
                    </p>
                    <ul class="track-tags">
                        <li>Google Cloud</li>
                        <li>Kubernetes</li>
                        <li>Cybersecurity</li>
                        <li>Infrastructure</li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon">📱</div>
                    <h3 class="track-title">Languages & Mobile</h3>
                    <p class="track-description">
                        Building performant applications with Go, Kotlin, Dart, Flutter, React Native, Android, and iOS.
                    </p>
                    <ul class="track-tags">
                        <li>Flutter & Dart</li>
                        <li>Android & Kotlin</li>
                        <li>Go</li>
                        <li>iOS & Swift</li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon">🎯</div>
                    <h3 class="track-title">Career & Practices</h3>
                    <p class="track-description">
                        Engineering leadership, Management vs. IC tracks, technical interviewing, UX design, and project rituals.
                    </p>
                    <ul class="track-tags">
                        <li>Engineering Culture</li>
                        <li>UX / Product</li>
                        <li>Leadership</li>
                        <li>Tech Career</li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon">⚡</div>
                    <h3 class="track-title">Robotics & Hardware</h3>
                    <p class="track-description">
                        IoT ecosystems, edge computing, hardware integration, and physical computing with connected devices.
                    </p>
                    <ul class="track-tags">
                        <li>IoT</li>
                        <li>Edge AI</li>
                        <li>Hardware</li>
                        <li>Embedded Systems</li>
                    </ul>
                </div>
            </div>

            {% if site.cfp.status == "open" and site.cfp.url %}
            <div class="tracks-cta">
                <p>Have an insight, case study, or deep dive to share?</p>
                <a class="track-cta-button" href="{{ site.cfp.url }}" target="_blank" rel="noopener">Submit Your Talk on Sessionize</a>
            </div>
            {% endif %}
        </div>
    </section>

    <!-- Date & Venue Section -->
    <section id="venue" class="outer venue-section">
        <div class="inner">
            <div class="venue-card">
                <div class="venue-item">
                    <span class="venue-badge">Confirmed Date</span>
                    <h3 class="venue-title">Saturday, November 14, 2026</h3>
                    <p class="venue-subtitle">Full-day conference with keynote talks, sessions & workshops</p>
                </div>
                <div class="venue-divider"></div>
                <div class="venue-item">
                    <span class="venue-badge">Host Venue</span>
                    <h3 class="venue-title">SRH Berlin</h3>
                    <p class="venue-subtitle">Sonnenallee 221, 12059 Berlin (Neukölln)</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="outer faq-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Frequently Asked Questions</h2>
                <p class="section-subtitle">
                    Everything you need to know about DevFest Berlin 2026.
                </p>
            </div>

            <div class="faq-accordion">
                <details class="faq-item">
                    <summary>Where is the venue and how do I get there?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin 2026 takes place at <strong>SRH Berlin University of Applied Sciences</strong>,
                            located at <strong>Sonnenallee 221, 12059 Berlin</strong> (Neukölln).
                        </p>
                        <p>
                            <strong>Public Transit:</strong><br>
                            &bull; <strong>S-Bahn:</strong> S41, S42 (Ringbahn), S45, S46, S47 (Station <em>S Sonnenallee</em> or <em>S Köllnische Heide</em>, ~5–8 min walk).<br>
                            &bull; <strong>Bus:</strong> M41 (direct connection from Berlin Hauptbahnhof, Potsdamer Platz, and Hermannplatz).
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When does the Call for Speakers (CFP) close?</summary>
                    <div class="faq-answer">
                        <p>
                            The Call for Speakers is open through <strong>November 1, 2026 at 11:59 PM CET</strong>.
                            You can submit talk proposals directly on <a href="{{ site.cfp.url }}" target="_blank" rel="noopener">Sessionize</a>.
                            Speaker selections and schedule announcements will follow in early November.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>Who can submit a talk proposal?</summary>
                    <div class="faq-answer">
                        <p>
                            We warmly encourage speakers of all backgrounds, genders, and experience levels—including first-time speakers.
                            Whether you are presenting a beginner-friendly introduction or a deep technical dive, our community welcomes your perspective.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When will ticket sales go live?</summary>
                    <div class="faq-answer">
                        <p>
                            Ticket registration will open soon. Sign up via the <a href="/#subscribe">newsletter above</a> to be notified the moment Early Bird tickets go on sale.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>What is the Code of Conduct?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin is dedicated to providing a harassment-free and inclusive conference experience for everyone.
                            All attendees, speakers, sponsors, and organizers are required to adhere to the
                            <a href="https://berlincodeofconduct.org/en" target="_blank" rel="noopener">Berlin Code of Conduct</a>
                            and Google Event Community Guidelines throughout the event.
                        </p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Organizers Section -->
    <section id="organizers" class="outer organizers-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Community Organizers</h2>
                <p class="section-subtitle">
                    DevFest Berlin is collaboratively organized by local tech communities.
                </p>
            </div>

            <div class="organizers-grid">
                {% for org in site.organizers %}
                <div class="organizer-card">
                    <div>
                        <h3>{{ org.name }}</h3>
                        <p>{{ org.description }}</p>
                    </div>
                    <div>
                        <a class="card-link" href="{{ org.url }}" target="_blank" rel="noopener">
                            Join Community &rarr;
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Sponsors Section -->
    <section id="sponsors" class="outer sponsors-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">{{ site.sponsorship.title }}</h2>
                <p class="section-subtitle">{{ site.sponsorship.pitch }}</p>
            </div>
            {% if site.sponsors.length %}
            {% include "partials/sponsor-wall.njk" %}
            {% endif %}
            <p class="sponsors-action">
                <a class="sponsor-button" href="/sponsors/">Become a sponsor</a>
            </p>
        </div>
    </section>

    <!--
    ====================================================================
    FUTURE EXPANSION SECTIONS:
    When ready, drop in:
    1. Ticketing / Eventbrite CTA
    2. Sessionize Agenda Embed (e.g. <script src="https://sessionize.com/api/v2/..."></script>)
    3. Venue & Location Details
    4. FAQ Accordion
    ====================================================================
    -->

</main>
