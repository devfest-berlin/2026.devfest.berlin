---
layout: base.njk
bodyClass: "home-template is-head-left-logo has-cover"
---


<!-- Casper Hero Header -->
<div class="site-header-content outer">
    {% if site.coverImage %}
    <img class="site-header-cover"
        src="{{ site.coverImage }}"
        alt="{{ site.title }}"
        fetchpriority="high"
        loading="eager"
    />
    {% endif %}

    <div class="site-header-inner inner">
        {% if site.status %}
        <div class="status-pill">{{ site.status }}</div>
        {% endif %}
        <h1 class="site-title">{{ site.title }}</h1>
        {% if site.description %}
        <p class="site-description">{{ site.description }}</p>
        {% endif %}

        <!-- Live Event Countdown -->
        <div class="hero-countdown" id="event-countdown" data-target="{{ site.eventDate }}T09:00:00+01:00" role="timer" aria-label="Countdown to DevFest Berlin 2026">
            <div class="countdown-unit">
                <div class="countdown-value" id="countdown-days">--</div>
                <div class="countdown-title">Days</div>
            </div>
            <div class="countdown-separator" aria-hidden="true">:</div>
            <div class="countdown-unit">
                <div class="countdown-value" id="countdown-hours">--</div>
                <div class="countdown-title">Hours</div>
            </div>
            <div class="countdown-separator" aria-hidden="true">:</div>
            <div class="countdown-unit">
                <div class="countdown-value" id="countdown-minutes">--</div>
                <div class="countdown-title">Minutes</div>
            </div>
            <div class="countdown-separator" aria-hidden="true">:</div>
            <div class="countdown-unit">
                <div class="countdown-value" id="countdown-seconds">--</div>
                <div class="countdown-title">Seconds</div>
            </div>
        </div>

        {% set cfpOpen = site.cfp.status == "open" and site.cfp.url %}
        {% set ticketsOpen = site.tickets.status == "open" and site.tickets.url %}
        <div class="hero-actions">
            {% if ticketsOpen %}
            <a class="hero-button" href="{{ site.tickets.url }}" target="_blank" rel="noopener">{{ site.tickets.buttonText }}</a>
            {% else %}
            <button type="button" class="hero-button is-earlybird" id="open-earlybird-modal" aria-haspopup="dialog" aria-controls="earlybird-modal">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <span>Early Bird Alert</span>
            </button>
            {% endif %}
            {% if cfpOpen %}
            <a class="hero-button{% if ticketsOpen %} is-secondary{% endif %}" href="{{ site.cfp.url }}" target="_blank" rel="noopener">{{ site.cfp.buttonText }}</a>
            {% endif %}
            {% if site.calendarUrl %}
            <a class="hero-button is-calendar" href="{{ site.calendarUrl }}" target="_blank" rel="noopener" title="Add to Calendar">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <span>Add to Calendar</span>
            </a>
            {% endif %}
        </div>
        {% if cfpOpen and site.cfp.deadline %}
        <p class="hero-note">{{ site.cfp.label }} open until {{ site.cfp.deadline }}</p>
        {% endif %}
    </div>
</div>

<!-- Conference Impact Statistics (Inspired by DevFest Istanbul) -->
{% if site.stats.length %}
<section class="outer stats-section" aria-label="DevFest Berlin by the numbers">
    <div class="inner">
        <div class="stats-grid">
            {% for item in site.stats %}
            <div class="stat-card">
                <div class="stat-value">{{ item.value }}</div>
                <div class="stat-label">{{ item.label }}</div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<main id="site-main" class="site-main">

    <!-- Newsletter / Subscribe Call to Action -->
    <section id="subscribe" class="footer-cta outer subscribe-section">
        <div class="inner">
            <h2 class="footer-cta-title">{{ site.newsletter.title }}</h2>
            <p style="max-width: 600px; margin: 0 auto 28px; font-size: 1.7rem; color: var(--color-secondary-text);">
                {{ site.newsletter.description }}
            </p>

            <form id="subscribe-form" class="footer-cta-form" action="{{ site.newsletter.action }}" method="POST">
                <input
                    type="email"
                    name="{{ site.newsletter.emailFieldName }}"
                    placeholder="Enter your email address"
                    aria-label="Email address"
                    required
                />
                <button type="submit">{{ site.newsletter.buttonText }}</button>
            </form>
            <div id="subscribe-feedback" class="subscribe-feedback" role="status" aria-live="polite"></div>
            {% if site.newsletter.privacyNote %}
            <p class="subscribe-privacy">
                {{ site.newsletter.privacyNote }} <a href="/datenschutz/#newsletter">Privacy details</a>
            </p>
            {% endif %}
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="outer about-section">
        <div class="inner about-content">
            <h2 class="section-title">What is DevFest?</h2>
            <p class="about-text">
                DevFests are community-led developer events hosted by Google Developer Groups worldwide.
                DevFest Berlin brings together engineers, designers, and tech leaders for talks, workshops,
                and networking across Android, Web, Cloud, AI, and more.
            </p>
        </div>
    </section>

    <!-- Tracks & Topics Section -->
    <section id="tracks" class="outer tracks-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Tracks & Topics</h2>
                <p class="section-subtitle">
                    Explore talks, panels, and deep technical dives across five curated themes for DevFest Berlin 2026.
                </p>
            </div>

            <div class="tracks-grid">
                <div class="track-card">
                    <div class="track-icon-badge is-ai">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10H12V2Z"/><circle cx="12" cy="12" r="3"/><path d="M12 2v10l8.5 4.5"/></svg>
                    </div>
                    <h3 class="track-title">AI &amp; Machine Learning</h3>
                    <p class="track-description">
                        Applications, ethics, dev tools, model management, and practical agentic workflows with modern AI.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20"><defs><linearGradient id="geminiGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#4285F4"/><stop offset="50%" stop-color="#9B72CB"/><stop offset="100%" stop-color="#D96570"/></linearGradient></defs><path fill="url(#geminiGrad)" d="M12 2C12 7.52 7.52 12 2 12c5.52 0 10 4.48 10 10 0-5.52 4.48-10 10-10-5.52 0-10-4.48-10-10z"/></svg>
                            <span>Gemini &amp; AI</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#4285F4"><path d="M12 2L4 6v12l8 4 8-4V6l-8-4zm0 2.3L18 7v4.5L12 8 6 11.5V7l6-2.7zM6 13.8l5 2.8v5l-5-2.5v-5.3zm7 7.8v-5l5-2.8v5.3l-5 2.5z"/></svg>
                            <span>Vertex AI</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20"><path fill="#FF6F00" d="M12 2L4 7v10l8 5 8-5V7l-8-5zm0 2.2l6 3.8v7.9l-6 3.8-6-3.8V8l6-3.8z"/><path fill="#FFA000" d="M12 4.2L6 8v7.9l6 3.8V4.2z"/></svg>
                            <span>TensorFlow</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#EE4C2C"><path d="M12.5 3a.5.5 0 0 0-.7.1L9 6.8a.5.5 0 0 0 .7.7L12 5.2V11a.5.5 0 0 0 1 0V5.2l2.3 2.3a.5.5 0 0 0 .7-.7l-2.8-3.7a.5.5 0 0 0-.7-.1zM6.5 9A5.5 5.5 0 0 0 12 14.5a5.5 5.5 0 0 0 5.5-5.5.5.5 0 0 0-1 0 4.5 4.5 0 0 1-4.5 4.5A4.5 4.5 0 0 1 7.5 9a.5.5 0 0 0-1 0zM12 16a7 7 0 0 1-7-7 .5.5 0 0 1 1 0 6 6 0 0 0 6 6 6 6 0 0 0 6-6 .5.5 0 0 1 1 0 7 7 0 0 1-7 7z"/></svg>
                            <span>PyTorch</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-cloud">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/><path d="M12 12v4M10 14h4"/></svg>
                    </div>
                    <h3 class="track-title">Cloud &amp; Security</h3>
                    <p class="track-description">
                        GCP, multi-cloud architectures, cybersecurity, DevSecOps, and robust infrastructure threat defense.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20"><path fill="#4285F4" d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/><path fill="#34A853" d="M12 4c-3.13 0-5.78 2.14-6.52 5.04C6.27 8.64 7.1 8.35 8 8.16 9.07 5.71 11.37 4 14 4c.69 0 1.36.12 2 .33V4h-4z"/><path fill="#FBBC05" d="M6 14c0 3.31 2.69 6 6 6v-4H6z"/><path fill="#EA4335" d="M19 14h-7v4h7c1.66 0 3-1.34 3-3s-1.34-3-3-3z"/></svg>
                            <span>Google Cloud</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#326CE5"><path d="M11.998.11a1.14 1.14 0 0 0-.573.155L2.35 5.518a1.14 1.14 0 0 0-.57.989v10.986c0 .41.22.787.57.989l9.075 5.253a1.14 1.14 0 0 0 1.146 0l9.075-5.253a1.14 1.14 0 0 0 .57-.989V6.507a1.14 1.14 0 0 0-.57-.989L12.571.265a1.14 1.14 0 0 0-.573-.155zm-.016 2.455l6.98 4.041-2.43 1.408-4.55-2.637v-2.812zm-1.042.006v2.806L6.39 8.014 3.96 6.606l6.98-4.035zM2.85 7.97l2.43 1.408v5.275L2.85 16.06V7.97zm18.3 0v8.09l-2.43-1.407V9.378l2.43-1.408zm-8.652 1.488a2.54 2.54 0 1 1 0 5.08 2.54 2.54 0 0 1 0-5.08zm-4.707 5.766l4.185 2.424v4.832l-6.615-3.83 2.43-3.426zm10.456 0l2.43 3.426-6.615 3.83v-4.832l4.185-2.424z"/></svg>
                            <span>Kubernetes</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#34A853"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                            <span>Cybersecurity</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#4285F4"><path d="M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm0 12h16a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2zm2-8v2h2V6H6zm0 12v2h2v-2H6z"/></svg>
                            <span>DevOps &amp; Infra</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-mobile">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                    </div>
                    <h3 class="track-title">Languages &amp; Mobile</h3>
                    <p class="track-description">
                        Building performant applications with Go, Kotlin, Dart, Flutter, React Native, Android, and iOS.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20"><path fill="#42A5F5" d="M14.314 0L2.3 12l3.694 3.694L21.703 0h-7.389z"/><path fill="#02569B" d="M14.314 11.077L7.842 17.55l3.694 3.694 2.778-2.778 7.389-7.389h-7.389z"/><path fill="#0175C2" d="M11.536 21.244l2.778 2.756h7.389l-5.545-5.534-4.622 2.778z"/><path fill="#29B6F6" d="M14.314 11.077l4.622 4.622-4.622 4.622-2.778-2.778 2.778-6.466z"/></svg>
                            <span>Flutter &amp; Dart</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#3DDC84"><path d="M6 18c0 .55.45 1 1 1h1v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h2v3.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5V19h1c.55 0 1-.45 1-1V8H6v10zm-3.5-10C1.67 8 1 8.67 1 9.5v6c0 .83.67 1.5 1.5 1.5S4 16.33 4 15.5v-6C4 8.67 3.33 8 2.5 8zm19 0c-.83 0-1.5.67-1.5 1.5v6c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5v-6c0-.83-.67-1.5-1.5-1.5zm-5.97-4.84l1.3-1.3c.2-.2.2-.51 0-.71-.2-.2-.51-.2-.71 0l-1.48 1.48C13.85 2.23 12.95 2 12 2c-.96 0-1.86.23-2.66.63L7.85 1.15c-.2-.2-.51-.2-.71 0-.2.2-.2.51 0 .71l1.31 1.31C6.97 4.26 6 5.76 6 7.5h12c0-1.74-.97-3.24-2.47-4.34zM9 5.5c-.41 0-.75-.34-.75-.75s.34-.75.75-.75.75.34.75.75-.34.75-.75.75zm6 0c-.41 0-.75-.34-.75-.75s.34-.75.75-.75.75.34.75.75-.34.75-.75.75z"/></svg>
                            <span>Android</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20"><defs><linearGradient id="ktGrad2" x1="0%" y1="100%" x2="100%" y2="0%"><stop offset="0%" stop-color="#0095D5"/><stop offset="30%" stop-color="#387EB8"/><stop offset="50%" stop-color="#7F52FF"/><stop offset="70%" stop-color="#C711E1"/><stop offset="100%" stop-color="#E4485D"/></linearGradient></defs><path fill="url(#ktGrad2)" d="M22 22H2V2h20L12 12Z"/></svg>
                            <span>Kotlin</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20"><rect width="24" height="24" rx="6" fill="#00ADD8"/><text x="12" y="16.5" font-family="system-ui, -apple-system, sans-serif" font-weight="900" font-size="12" fill="#fff" text-anchor="middle" letter-spacing="-0.5px">GO</text></svg>
                            <span>Go &amp; Backend</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-career">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>
                    </div>
                    <h3 class="track-title">Career &amp; Practices</h3>
                    <p class="track-description">
                        Engineering leadership, Management vs. IC tracks, technical interviewing, UX design, and project rituals.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#EA8600" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <span>Team Culture</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#E91E63" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            <span>UX &amp; Product</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="#1a73e8"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                            <span>Leadership</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#5F6368" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                            <span>Career Growth</span>
                        </li>
                    </ul>
                </div>

                <div class="track-card">
                    <div class="track-icon-badge is-hardware">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
                    </div>
                    <h3 class="track-title">Robotics &amp; Hardware</h3>
                    <p class="track-description">
                        IoT ecosystems, edge computing, hardware integration, and physical computing with connected devices.
                    </p>
                    <ul class="track-tags">
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#9C27B0" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><circle cx="12" cy="20" r="1" fill="#9C27B0"/></svg>
                            <span>IoT Systems</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#673AB7" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3" fill="#673AB7"/><path d="M12 1v3M12 20v3M20 12h3M1 12h3"/></svg>
                            <span>Edge AI</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#E65100" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                            <span>Hardware &amp; PCB</span>
                        </li>
                        <li>
                            <svg class="tag-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#00897B" stroke-width="2"><rect x="5" y="5" width="14" height="14" rx="1"/><path d="M9 1v4M15 1v4M9 19v4M15 19v4M1 9h4M1 15h4M19 9h4M19 15h4"/></svg>
                            <span>Embedded Tech</span>
                        </li>
                    </ul>
                </div>
            </div>

            {% if site.cfp.status == "open" and site.cfp.url %}
            <div class="speaker-perks-section">
                <h3 class="perks-heading">Why Speak at DevFest Berlin?</h3>
                <div class="perks-grid">
                    {% for perk in site.speakerPerks %}
                    <div class="perk-card">
                        <div class="perk-icon-wrap">
                            {% if perk.icon == "pass" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><line x1="13" y1="5" x2="13" y2="19" stroke-dasharray="2"/></svg>
                            {% elif perk.icon == "video" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
                            {% elif perk.icon == "mentor" %}
                            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                            {% endif %}
                        </div>
                        <h4 class="perk-title">{{ perk.title }}</h4>
                        <p class="perk-text">{{ perk.description }}</p>
                    </div>
                    {% endfor %}
                </div>
            </div>

            <div class="tracks-cta">
                <p>Have an insight, case study, or deep dive to share with Berlin's tech community?</p>
                <a class="track-cta-button" href="{{ site.cfp.url }}" target="_blank" rel="noopener">
                    <span>Submit Your Talk on Sessionize</span>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <span class="track-cta-deadline">CFP closes November 1, 2026 at 23:59 CET</span>
            </div>
            {% endif %}
        </div>
    </section>

    <!-- Date & Venue Section -->
    <section id="venue" class="outer venue-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Date & Location</h2>
                <p class="section-subtitle">Join us at the cutting-edge SRH Berlin campus in Neukölln for DevFest Berlin 2026.</p>
            </div>

            <div class="venue-showcase-container">
                <!-- Left: Venue Visual & Facilities Card -->
                <div class="venue-visual-card">
                    <div class="venue-visual-header">
                        <div class="venue-visual-badge">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg>
                            <span>Neukölln, Berlin</span>
                        </div>
                        <span class="venue-date-pill">Nov 14, 2026</span>
                    </div>

                    <div class="venue-graphic-art">
                        <div class="venue-building-icon">
                            <svg viewBox="0 0 64 64" width="60" height="60" fill="none">
                                <rect x="8" y="18" width="48" height="40" rx="4" fill="rgba(66, 133, 244, 0.12)" stroke="#1a73e8" stroke-width="2.5"/>
                                <path d="M8 28h48M24 18v40M40 18v40" stroke="#1a73e8" stroke-width="1.5" stroke-dasharray="3 3"/>
                                <path d="M4 18l28-11 28 11" stroke="#ea4335" stroke-width="3" stroke-linecap="round"/>
                                <rect x="27" y="42" width="10" height="16" rx="2" fill="#34a853"/>
                            </svg>
                        </div>
                        <div class="venue-campus-meta">
                            <h3 class="venue-campus-name">SRH Berlin Campus</h3>
                            <p class="venue-campus-tagline">Modern academic tech campus equipped with spacious keynote auditoriums, collaborative rooms, and open courtyards.</p>
                        </div>
                    </div>

                    <!-- Campus Facilities Grid -->
                    <div class="venue-facilities-grid">
                        <div class="facility-item">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#1a73e8" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                            <span>Keynote Auditoriums</span>
                        </div>
                        <div class="facility-item">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#34a853" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8M12 8v8"/></svg>
                            <span>100% Barrier-Free</span>
                        </div>
                        <div class="facility-item">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#ea8600" stroke-width="2"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><circle cx="12" cy="20" r="1" fill="#ea8600"/></svg>
                            <span>Gigabit Campus WiFi</span>
                        </div>
                        <div class="facility-item">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#673ab7" stroke-width="2"><circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><path d="M15 6a1 1 0 1 0 0-2 1 1 0 0 0 0 2zm-3 11.5L8.5 7.5l4-2.5 3 4.5h3"/></svg>
                            <span>Secure Bike Racks</span>
                        </div>
                    </div>
                </div>

                <!-- Right: Location Details & Smart Transit Hub -->
                <div class="venue-details-card">
                    <div class="venue-header-block">
                        <span class="venue-label-chip">Host Campus</span>
                        <h3 class="venue-name-heading">{{ site.venue.name }}</h3>
                        <div class="venue-address-row">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            <span>{{ site.venue.streetAddress }}, {{ site.venue.postalCode }} Berlin ({{ site.venue.neighborhood }})</span>
                            <button type="button" class="copy-address-btn" id="copy-venue-address" data-address="{{ site.venue.streetAddress }}, {{ site.venue.postalCode }} Berlin" title="Copy Address">
                                <svg class="copy-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                <span class="copy-label">Copy</span>
                            </button>
                        </div>
                    </div>

                    <div class="transit-hub-section">
                        <h4 class="transit-hub-title">Getting to SRH Berlin</h4>

                        <div class="transit-route-card">
                            <div class="transit-pill s-bahn">S-Bahn</div>
                            <div class="transit-route-details">
                                <div class="transit-route-lines"><strong>S41, S42 (Ringbahn), S45, S46, S47</strong></div>
                                <div class="transit-route-desc">Exit at <strong>S Sonnenallee</strong> or <strong>S Köllnische Heide</strong> (5&ndash;8 min walk)</div>
                            </div>
                        </div>

                        <div class="transit-route-card">
                            <div class="transit-pill bus">Bus M41</div>
                            <div class="transit-route-details">
                                <div class="transit-route-lines"><strong>MetroBus M41</strong> (Direct Connection)</div>
                                <div class="transit-route-desc">From <strong>Berlin Hauptbahnhof, Potsdamer Platz &amp; Hermannplatz</strong> directly to Sonnenallee</div>
                            </div>
                        </div>

                        <div class="transit-route-card">
                            <div class="transit-pill bike">Car &amp; Bike</div>
                            <div class="transit-route-details">
                                <div class="transit-route-lines"><strong>Fast Access via A100 Highway</strong></div>
                                <div class="transit-route-desc">Sonnenallee exit with ample on-campus bicycle racks and nearby parking</div>
                            </div>
                        </div>
                    </div>

                    <div class="venue-action-cluster">
                        <a class="venue-btn is-maps" href="{{ site.venue.mapsUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                            <span>Open in Google Maps</span>
                        </a>
                        <a class="venue-btn is-bvg" href="{{ site.venue.transitUrl }}" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="3" width="16" height="16" rx="2"/><circle cx="8" cy="15" r="1"/><circle cx="16" cy="15" r="1"/><line x1="4" y1="11" x2="20" y2="11"/></svg>
                            <span>BVG Route Planner</span>
                        </a>
                        {% if site.calendarUrl %}
                        <a class="venue-btn is-calendar" href="{{ site.calendarUrl }}" target="_blank" rel="noopener" title="Add to Calendar">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            <span>Add to Calendar</span>
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="outer faq-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Frequently Asked Questions</h2>
                <p class="section-subtitle">
                    Everything you need to know about DevFest Berlin 2026.
                </p>
            </div>

            <div class="faq-accordion">
                <details class="faq-item">
                    <summary>Where is the venue and how do I get there?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin 2026 takes place at <strong>SRH Berlin University of Applied Sciences</strong>,
                            located at <strong>Sonnenallee 221, 12059 Berlin</strong> (Neukölln).
                        </p>
                        <p>
                            <strong>Public Transit:</strong><br>
                            &bull; <strong>S-Bahn:</strong> S41, S42 (Ringbahn), S45, S46, S47 (Station <em>S Sonnenallee</em> or <em>S Köllnische Heide</em>, ~5–8 min walk).<br>
                            &bull; <strong>Bus:</strong> M41 (direct connection from Berlin Hauptbahnhof, Potsdamer Platz, and Hermannplatz).
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When does the Call for Speakers (CFP) close?</summary>
                    <div class="faq-answer">
                        <p>
                            The Call for Speakers is open through <strong>November 1, 2026 at 11:59 PM CET</strong>.
                            You can submit talk proposals directly on <a href="{{ site.cfp.url }}" target="_blank" rel="noopener">Sessionize</a>.
                            Speaker selections and schedule announcements will follow in early November.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>Who can submit a talk proposal?</summary>
                    <div class="faq-answer">
                        <p>
                            We warmly encourage speakers of all backgrounds, genders, and experience levels—including first-time speakers.
                            Whether you are presenting a beginner-friendly introduction or a deep technical dive, our community welcomes your perspective.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>When will ticket sales go live?</summary>
                    <div class="faq-answer">
                        <p>
                            Ticket registration will open soon. Sign up via the <a href="/#subscribe">newsletter above</a> to be notified the moment Early Bird tickets go on sale.
                        </p>
                    </div>
                </details>

                <details class="faq-item">
                    <summary>What is the Code of Conduct?</summary>
                    <div class="faq-answer">
                        <p>
                            DevFest Berlin is dedicated to providing a harassment-free and inclusive conference experience for everyone.
                            All attendees, speakers, sponsors, and organizers are required to adhere to the
                            <a href="https://berlincodeofconduct.org/en" target="_blank" rel="noopener">Berlin Code of Conduct</a>
                            and Google Event Community Guidelines throughout the event.
                        </p>
                    </div>
                </details>
            </div>
        </div>
    </section>

    <!-- Organizers Section -->
    <section id="organizers" class="outer organizers-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">Community Organizers</h2>
                <p class="section-subtitle">
                    DevFest Berlin is collaboratively organized by local tech communities.
                </p>
            </div>

            <div class="organizers-grid">
                {% for org in site.organizers %}
                <div class="organizer-card">
                    <div>
                        <div class="organizer-card-header">
                            {% if org.logo %}
                            <div class="organizer-logo-wrap">
                                <img src="{{ org.logo }}" alt="{{ org.name }} logo" class="organizer-logo" loading="lazy" />
                            </div>
                            {% endif %}
                            <h3 class="organizer-name">{{ org.name }}</h3>
                        </div>
                        <p class="organizer-description">{{ org.description }}</p>
                    </div>
                    <div class="organizer-card-action">
                        <a class="card-link" href="{{ org.url }}" target="_blank" rel="noopener">
                            Join Community &rarr;
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <!-- Sponsors Section -->
    <section id="sponsors" class="outer sponsors-section">
        <div class="inner">
            <div class="section-header">
                <h2 class="section-title">{{ site.sponsorship.title }}</h2>
                <p class="section-subtitle">{{ site.sponsorship.pitch }}</p>
            </div>
            {% if site.sponsors.length %}
            {% include "partials/sponsor-wall.njk" %}
            {% endif %}
            <p class="sponsors-action">
                <a class="sponsor-button" href="/sponsors/">Become a sponsor</a>
            </p>
        </div>
    </section>

    <!--
